# =============================================================================
# AthenaV2 Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# In Docker/production deployments, set these as container environment variables.
# Variables marked [REQUIRED] must be set for the application to start.
# Variables marked [OPTIONAL] have sensible defaults or are feature-specific.
# =============================================================================


# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# [OPTIONAL] JWT signing secret for NextAuth. If not set, one is auto-generated
# and persisted to .runtime/auth-secret.json on first startup. For production
# clusters (multiple replicas), set this explicitly so all instances share the
# same secret.
NEXTAUTH_SECRET=

# [REQUIRED in production] The canonical public URL of your deployment.
# Used by NextAuth for redirect handling and by the push notification system.
# Example: https://scouting.yourteam.com
NEXTAUTH_URL=http://localhost:3000

# [OPTIONAL] Public app URL for building absolute links in notifications/emails.
# Falls back to NEXTAUTH_URL if not set.
NEXT_PUBLIC_APP_URL=


# -----------------------------------------------------------------------------
# Database — choose ONE provider and configure its section below.
# Set DATABASE_PROVIDER to override auto-detection, otherwise the app will
# auto-detect based on which variables are present (priority: azuresql >
# cosmos > firebase > mariadb).
# -----------------------------------------------------------------------------

# [OPTIONAL] Explicit provider selection. Values: azuresql | mariadb | cosmos | firebase
DATABASE_PROVIDER=


# --- Azure SQL (recommended for Azure-hosted deployments) -------------------

# Option A: Connection string (takes precedence over individual fields)
AZURE_SQL_CONNECTION_STRING=

# Option B: Individual connection fields
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=

# [OPTIONAL] Set to "true" to use Azure Managed Identity instead of
# username/password. When true, AZURE_SQL_USER and AZURE_SQL_PASSWORD are
# ignored. Defaults to true if user/password are not provided.
AZURE_SQL_USE_MANAGED_IDENTITY=false


# --- MariaDB / MySQL --------------------------------------------------------

# Option A: Connection string
MARIADB_CONNECTION_STRING=
# MYSQL_CONNECTION_STRING=   # MySQL alias — either prefix works

# Option B: Individual connection fields
MARIADB_HOST=
MARIADB_DATABASE=
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_PORT=3306
# MYSQL_HOST=                # MySQL aliases — either prefix works
# MYSQL_DATABASE=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_PORT=


# --- Azure Cosmos DB --------------------------------------------------------

COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE_ID=
COSMOS_CONTAINER_ID=


# --- Firebase Firestore -----------------------------------------------------

# Option A: Path to a service account JSON file on the container filesystem
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option B: Inline service account JSON (useful for secrets managers)
FIREBASE_SERVICE_ACCOUNT_JSON=

FIREBASE_DATABASE_URL=


# -----------------------------------------------------------------------------
# External API Keys
# These can also be configured at runtime via the /settings UI, which persists
# them to .runtime/api-keys.json. Environment variables take precedence.
# -----------------------------------------------------------------------------

# [OPTIONAL] The Blue Alliance API key — required for FRC event data.
# Obtain one at https://www.thebluealliance.com/account
TBA_API_KEY=

# [OPTIONAL] FTC Events API key — required for FTC event data.
# Obtain one at https://ftc-events.firstinspires.org/services/API
FTC_API_KEY=

# [OPTIONAL] FRC Nexus API key — required for pit map and event status features.
NEXUS_API_KEY=

# [OPTIONAL] TBA webhook secret for verifying incoming match alert webhooks.
# Set this to the secret configured in your TBA account webhook settings.
TBA_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Push Notifications (Web Push / VAPID)
# Generate a VAPID key pair with: npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------

# [OPTIONAL] VAPID public key — also exposed to the client for push subscription.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # Must match VAPID_PUBLIC_KEY — used on the client side

# [OPTIONAL] VAPID private key — keep this secret.
VAPID_PRIVATE_KEY=

# [OPTIONAL] Contact email or URL included in VAPID headers (required by the
# Web Push spec for abuse contact). Defaults to a placeholder if not set.
# Example: mailto:yourteam@example.com  or  https://yourteam.example.com
VAPID_CONTACT_EMAIL=


# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------

# [OPTIONAL] Port override for end-to-end (Playwright) tests.
# E2E_PORT=3000
